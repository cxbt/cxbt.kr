{{- /* One page per album in data/music/albums.json (written by scripts/sync_ytmusic.py).
       list = "local" keeps album pages out of the home page's post list and the RSS feed. */ -}}
{{- with hugo.Data.music.albums -}}
  {{- range .albums -}}
    {{- $.AddPage (dict
        "path" .albumId
        "kind" "page"
        "title" .title
        "params" (dict "albumId" .albumId)
        "build" (dict "list" "local" "render" "always" "publishResources" true)
    ) -}}
  {{- end -}}
{{- end -}}
